POSTGRES_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email sync (optional). Without these, the "Connect Gmail" feature stays hidden.
# Google OAuth app with the Gmail API enabled and the gmail.readonly scope.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google AI Studio API key, used to classify emails with Gemini 2.5 Flash.
# Get one at https://aistudio.google.com/apikey (free tier available).
GOOGLE_GENERATIVE_AI_API_KEY=
