POSTGRES_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email sync (optional). Without these, the "Connect Gmail" feature stays hidden.
# Google OAuth app with the Gmail API enabled and the gmail.readonly scope.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google AI Studio API key, used to classify emails with Gemini 2.5 Flash.
# Public deployments must use a Cloud project with active billing. Google's
# unpaid Gemini terms do not permit sending personal or confidential content.
# Set the confirmation flag only after billing is active for this API project.
# Get a key at https://aistudio.google.com/apikey.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_PAID_SERVICE=false

# Optional contact email shown on the legal pages.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# Browser-extension store listings shown by the local-import prompt. Until the
# listings are published, the prompt links to the repository setup guide.
NEXT_PUBLIC_CHROME_EXTENSION_URL=
NEXT_PUBLIC_FIREFOX_EXTENSION_URL=

# Public Job Tracker URL allowed to connect to the extension. This is your app
# URL, not a job-board URL. Separate multiple deployments with commas.
JOB_TRACKER_EXTENSION_APP_ORIGINS=http://localhost/*
