{
    "name": "job-tracker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "bun test",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "extension:build": "bun run extension/build.ts",
        "db:new": "dbmate --env POSTGRES_URL new",
        "db:migrate": "dbmate --env POSTGRES_URL --no-dump-schema up",
        "db:rollback": "dbmate --env POSTGRES_URL --no-dump-schema rollback",
        "db:generate": "sqlc generate",
        "db:seed": "bun run db/seed.ts",
        "db:test-account": "bun run db/test-account.ts",
        "flags:sync": "bun run scripts/sync-flags.ts",
        "metrics": "bun run scripts/metrics.ts"
    },
    "dependencies": {
        "@ai-sdk/google": "^4.0.23",
        "@neondatabase/serverless": "^1.1.0",
        "@nivo/bar": "^0.99.0",
        "@nivo/core": "^0.99.0",
        "@nivo/line": "^0.99.0",
        "@nivo/sankey": "^0.99.0",
        "@nivo/tooltip": "^0.99.0",
        "@yudiel/react-qr-scanner": "^2.6.0",
        "ai": "^7.0.36",
        "better-auth": "^1.6.23",
        "html-to-image": "^1.11.13",
        "next": "16.2.10",
        "papaparse": "^5.6.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "read-excel-file": "^9.3.10",
        "sonner": "^2.0.7",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@iconify-json/circle-flags": "^1.2.10",
        "@iconify-json/lucide": "^1.2.118",
        "@iconify-json/simple-icons": "^1.2.90",
        "@iconify/tailwind4": "^1.2.3",
        "@tailwindcss/postcss": "^4",
        "@types/bun": "^1.3.14",
        "@types/node": "^20",
        "@types/papaparse": "^5.5.2",
        "@types/pg": "^8.20.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dbmate": "^2.34.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.5",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
