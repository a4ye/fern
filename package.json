{
    "name": "job-tracker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:new": "dbmate --env POSTGRES_URL new",
        "db:migrate": "dbmate --env POSTGRES_URL --no-dump-schema up",
        "db:rollback": "dbmate --env POSTGRES_URL --no-dump-schema rollback",
        "db:generate": "sqlc generate"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "next": "16.2.10",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    },
    "devDependencies": {
        "@iconify-json/simple-icons": "^1.2.90",
        "@iconify/tailwind4": "^1.2.3",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/pg": "^8.20.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dbmate": "^2.34.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.5",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
